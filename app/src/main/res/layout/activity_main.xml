<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/bg"> 

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SimpleTranslator"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primaryText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="12dp"
        android:contentDescription="App logo"
        android:src="@android:drawable/sym_def_app_icon"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tap LISTEN and speak"
        android:textSize="14sp"
        android:textColor="@color/secondaryText"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnListen"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="LISTEN"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="@color/accent"
        android:textColor="@color/buttonText"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:shape="rectangle"/>

    <Button
        android:id="@+id/btnManageModels"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Manage Models"
        android:textAllCaps="false"
        android:backgroundTint="@color/secondaryAccent"
        android:textColor="@color/buttonText"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnListen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvRecognizedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recognized:"
        android:textStyle="bold"
        android:textColor="@color/primaryText"
        app:layout_constraintTop_toBottomOf="@id/btnManageModels"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="18dp"/>

    <TextView
        android:id="@+id/tvRecognized"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/primaryText"
        app:layout_constraintTop_toBottomOf="@id/btnManageModels"
        app:layout_constraintStart_toEndOf="@id/tvRecognizedLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="18dp"/>

    <TextView
        android:id="@+id/tvTranslatedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Translated:"
        android:textStyle="bold"
        android:textColor="@color/primaryText"
        app:layout_constraintTop_toBottomOf="@id/tvRecognized"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="14dp"/>

    <TextView
        android:id="@+id/tvTranslated"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/primaryText"
        app:layout_constraintTop_toBottomOf="@id/tvRecognized"
        app:layout_constraintStart_toEndOf="@id/tvTranslatedLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="14dp"/>

    <Button
        android:id="@+id/btnSpeakTranslation"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Speak Translation"
        android:textAllCaps="false"
        android:backgroundTint="@color/accent"
        android:textColor="@color/buttonText"
        app:layout_constraintTop_toBottomOf="@id/tvTranslated"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
