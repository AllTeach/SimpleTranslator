<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <!-- Card containing status / recognized / translated (adaptive colors) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConversation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="?attr/colorSurface"
        app:strokeColor="?attr/colorOnSurface"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Small status text -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceCaption"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/cd_status" />

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <!-- Recognized label -->
            <TextView
                android:id="@+id/labelRecognized"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_recognized"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceCaption" />

            <!-- Recognized text -->
            <TextView
                android:id="@+id/tvRecognized"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recognized_placeholder"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="8dp"
                android:textIsSelectable="true"
                android:lineSpacingExtra="2dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.06" />

            <!-- Translated label -->
            <TextView
                android:id="@+id/labelTranslated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_translated"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceCaption"
                android:layout_marginTop="10dp"/>

            <!-- Translated text -->
            <TextView
                android:id="@+id/tvTranslated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/translated_placeholder"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="italic"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textIsSelectable="true"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Progress indicator (shown during detection/download/translate) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardConversation"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Auto-play switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAutoPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_play_label"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Speak Greek (for Greek speaker) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSpeakEl"
        style="@style/Widget.MyApp.RoundedButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="@string/btn_speak_greek"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnPrimary"
        app:cornerRadius="32dp"
        app:icon="@drawable/ic_mic"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/switchAutoPlay"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Speak English (for English speaker) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSpeakEn"
        style="@style/Widget.MyApp.RoundedButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="@string/btn_speak_english"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnPrimary"
        app:cornerRadius="32dp"
        app:icon="@drawable/ic_mic"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="?attr/colorSecondary"
        app:layout_constraintTop_toBottomOf="@id/btnSpeakEl"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>